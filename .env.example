# Dropbox Metadata Indexer - Environment Variables

# Token Service (AccessTokenDropbox)
TOKEN_SERVICE_URL=https://accesstokendropbox-223080314602.us-central1.run.app
API_SECRET_KEY=your-api-secret-key

# GCP Configuration
